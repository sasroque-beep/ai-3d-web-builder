# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored. Never commit real secrets (AGENTS.md §13).
#
# As modules are implemented, document their variables here (name + short
# description), keeping this file the single source of truth for
# configuration.

# Public base URL of the app, used for canonical URLs and metadata.
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Local SQLite (libSQL) database file used by src/server/db. Defaults to
# file:./.data/local.db when unset. Production persistence is not decided
# yet (see docs/DATABASE.md).
# DATABASE_URL="file:./.data/local.db"
